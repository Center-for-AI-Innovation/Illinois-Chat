# Root .env is the canonical local configuration for this monorepo.
# Docker Compose reads this file directly. Local app processes can source it and
# override Docker-internal service URLs to localhost when running outside Docker.

# =============================================================================
# REQUIRED LOCAL SECRETS
# =============================================================================
POSTGRES_PASSWORD="your-super-secret-and-long-postgres-password" # CHANGE ME
INGEST_REDIS_PASSWORD="your-strong-redis-password"               # CHANGE ME
QDRANT_API_KEY="your-strong-key-here"                            # Must match qdrant_config.yaml
AWS_ACCESS_KEY_ID="minioadmin"                                   # CHANGE ME for non-local use
AWS_SECRET_ACCESS_KEY="minioadmin"                               # CHANGE ME for non-local use
KEYCLOAK_ADMIN_PASSWORD="admin"                                  # CHANGE ME

# =============================================================================
# LOCAL RESOURCE NAMES
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_DATABASE=postgres
S3_BUCKET_NAME=uiuc-chat
QDRANT_COLLECTION_NAME=illinois-chat-qwen
# Backend VectorDatabase (Vyriad Qdrant client); local dev usually matches main Qdrant + QDRANT_API_KEY
VYRIAD_QDRANT_URL=http://localhost:6333
VYRIAD_QDRANT_PORT=6333
VYRIAD_QDRANT_API_KEY="your-strong-key-here"
AWS_REGION=us-east-1

# =============================================================================
# HOST PORTS
# =============================================================================
FRONTEND_PORT=3000
CRAWLEE_PORT=3345
POSTGRES_PORT=5432
KEYCLOAK_DB_PORT=5433
PUBLIC_MINIO_API_PORT=10000
PUBLIC_MINIO_DASHBOARD_PORT=9001
DOCKER_INTERNAL_MINIO_API_PORT=10000
DOCKER_INTERNAL_MINIO_DASHBOARD_PORT=9001

# Local app processes use the host MinIO API endpoint. Do not use the console port.
MINIO_ENDPOINT=http://localhost:9001
MINIO_PUBLIC_ENDPOINT=http://localhost:9001
MINIO_URL=http://localhost:9001

# =============================================================================
# AUTH
# =============================================================================
KEYCLOAK_ADMIN_USERNAME=admin
NEXT_PUBLIC_KEYCLOAK_URL="http://localhost:8080/"
NEXT_PUBLIC_KEYCLOAK_REALM=illinois_chat_realm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=illinois_chat
NEXT_PUBLIC_USE_ILLINOIS_CHAT_CONFIG=True
NEXT_PUBLIC_SIGNING_KEY=""

# =============================================================================
# MODEL ENDPOINTS
# =============================================================================
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_API_BASE=http://host.docker.internal:11434/v1
NCSA_HOSTED_API_KEY=
NCSA_HOSTED_VLM_BASE_URL=
OLLAMA_SERVER_URL=
VLADS_OPENAI_KEY=

# =============================================================================
# OPTIONAL OBSERVABILITY / INTEGRATIONS
# =============================================================================
POSTHOG_API_KEY=not_a_key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NOMIC_API_KEY=
SENTRY_DSN=
