# Port this service listens on.
PORT=3001

# Where to queue ingest jobs (the backend's Flask /ingest, or rabbitmq/bridge.py).
INGEST_URL=http://127.0.0.1:8000/ingest

# Bearer token sent to INGEST_URL. Optional: the backend fails open when it has no
# INGEST_API_KEY of its own, so leave this empty until the backend enforces it.
# When set, it must match the backend's INGEST_API_KEY exactly.
INGEST_API_KEY=

# Bearer token required on POST /crawl. REQUIRED — this service fails closed and
# answers 503 to every crawl request while it is unset. Must match the value the
# frontend and the backend's rerun_webcrawl_for_project.py send.
CRAWLEE_API_KEY=

# Set to "true" to skip the actual crawl (local development).
NO_CRAWL=FALSE

# Optional: path to a preinstalled Chromium, instead of Crawlee downloading one.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# No AWS/S3/MinIO variables: this service no longer writes to object storage.
# Crawled PDFs are reported to /ingest as a URL and the ingest worker downloads
# them into the bucket it resolved for the project.
