{
  // Benchmark-only config for the experimental `bun check` trial. It mirrors
  // tsconfig.build.json (the `npm run typecheck` config): same compilerOptions
  // and the same file selection. Differences, all forced by TypeScript 6/7 in
  // bun check, not chosen for speed:
  //   - no "baseUrl" (removed in TS 7); "paths" resolve relative to this file
  //   - no "plugins" (the Next.js language-service plugin is editor-only)
  //   - "types" is explicit, because TS 6+ only loads @types/* listed here
  //   - no "incremental" (bun check never writes .tsbuildinfo)
  // Canonical tsconfig.json / tsconfig.build.json are NOT modified.
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "types": [
      "aria-query",
      "babel__core",
      "babel__generator",
      "babel__template",
      "babel__traverse",
      "chai",
      "cookie",
      "d3-array",
      "d3-color",
      "d3-ease",
      "d3-interpolate",
      "d3-path",
      "d3-scale",
      "d3-shape",
      "d3-time",
      "d3-timer",
      "debug",
      "deep-eql",
      "diff-match-patch",
      "eslint",
      "estree",
      "hast",
      "hoist-non-react-statics",
      "istanbul-lib-coverage",
      "istanbul-lib-report",
      "istanbul-reports",
      "jest",
      "jest-axe",
      "js-cookie",
      "jsdom",
      "json-schema",
      "json5",
      "jsonwebtoken",
      "katex",
      "linkify-it",
      "lodash",
      "markdown-it",
      "mathjax",
      "mdast",
      "mdurl",
      "ms",
      "node",
      "node-fetch",
      "parse-json",
      "prop-types",
      "react",
      "react-dom",
      "react-syntax-highlighter",
      "retry",
      "sanitize-html",
      "selenium-webdriver",
      "set-cookie-parser",
      "stack-utils",
      "statuses",
      "tough-cookie",
      "trusted-types",
      "unist",
      "use-sync-external-store",
      "uuid",
      "ws",
      "yargs",
      "yargs-parser"
    ],
    "paths": {
      // Bare-module imports that canonical tsconfig resolves via baseUrl "."
      "fonts": ["./../../fonts.ts"],
      "database.types": ["./../../database.types.ts"],
      "src/*": ["./../../src/*"],
      "~/*": ["./../../src/*"],
      "@/*": ["./../../src/*"],
      "@/components/ui/*": ["./../../src/components/shadcn/ui/*"],
      "@/components/ai-elements/*": ["./../../src/components/ai-elements/*"]
    }
  },
  "include": [
    "../../.eslintrc.cjs",
    "../../next-env.d.ts",
    "../../**/*.ts",
    "../../**/*.tsx",
    "../../**/*.cjs",
    "../../**/*.mjs",
    "../../next-i18next.config.mjs",
    "../../src/app/api/chat/openaiFunctionCall",
    "../../.next/types/**/*.ts",
    "../../.next/dev/types/**/*.ts"
  ],
  "exclude": [
    "../../node_modules",
    "../../__tests__",
    "../../**/__tests__/**",
    "../../**/*.test.ts",
    "../../**/*.test.tsx",
    "../../**/*.spec.ts",
    "../../**/*.spec.tsx",
    "../../src/test-utils/**",
    "../../vitest.config.mts",
    "../../vitest.setup.ts"
  ]
}
