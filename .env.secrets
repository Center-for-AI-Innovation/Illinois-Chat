# Minimal set of secrets to set to be able to run the full stack using docker-compose.yaml
# Copy the file to a new file named `.env` and set the secrets before running docker compose

# passwords
INGEST_REDIS_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
POSTGRES_PASSWORD=
QDRANT_API_KEY=
VYRIAD_QDRANT_API_KEY=
KEYCLOAK_ADMIN_PASSWORD=

# LLMs
OLLAMA_SERVER_URL=
NCSA_HOSTED_VLM_BASE_URL=
EMBEDDING_API_BASE=
EMBEDDING_MODEL="Qwen/Qwen3-Embedding-8B"
NCSA_HOSTED_API_KEY=
